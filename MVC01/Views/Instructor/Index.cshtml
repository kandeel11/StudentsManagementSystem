@model ICollection<MVC01.Models.Instructor>

@section Nav {
    <a class="navbar-brand" asp-controller="Instructor" asp-action="Index">Instructor Management</a>
}
@section Header {
    <h1 class="text-center">Instructors Management</h1>
}

<div class="container mt-4">
    <h2>Instructors</h2>
    <a class="btn btn-info mb-3" asp-action="AddInstructor">Add Instructor</a>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Instructor ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Address</th>
                <th>Email</th>
                <th>Salary</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null)
            {
                foreach (var instructor in Model)
                {
                    <tr>
                        <td>@instructor.Ins_Id</td>
                        <td>@instructor.Name</td>
                        <td>@instructor.Age</td>
                        <td>@instructor.Address</td>
                        <td>@instructor.Email</td>
                        <td>@instructor.salary</td>
                        <td>
                            <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@instructor.Ins_Id">Details</a>
                            <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@instructor.Ins_Id">Edit</a>
                            <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@instructor.Ins_Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>