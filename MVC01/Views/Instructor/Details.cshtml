@model MVC01.Models.Instructor

<div class="container mt-4">
    <h2>Instructor Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Instructor ID</dt>
        <dd class="col-sm-10">@Model.Ins_Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Age</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>
        
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Salary</dt>
        <dd class="col-sm-10">@Model.salary</dd>
        
        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Department?.Name</dd>
    </dl>
    
    <h4 class="mt-4">Courses</h4>
    @if (Model.Instructor_Crs != null && Model.Instructor_Crs.Any())
    {
        <ul>
            @foreach (var ic in Model.Instructor_Crs)
            {
                <li>@ic.Course?.Name</li>
            }
        </ul>
    }
    else
    {
        <p>No courses assigned to this instructor.</p>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
