@model Instructor 

<div class="container mt-4">
    <h2 class="mb-4">Edit Instructor</h2>

    <form method="post" asp-action="Edit" asp-route-id="@Model.Ins_Id">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" value="@Model?.Name" placeholder="Enter instructor name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Age" class="form-label">Age</label>
                <input asp-for="Age" type="number" class="form-control" value="@Model?.Age" placeholder="Enter age" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" value="@Model?.Address" placeholder="Enter address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" value="@Model?.Email" placeholder="example@domain.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="salary" class="form-label">Salary</label>
                <input asp-for="salary" type="number" step="0.01" class="form-control" value="@Model?.salary" placeholder="Enter salary" />
                <span asp-validation-for="salary" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="DeptId" class="form-label">Department</label>
                <select asp-for="DeptId" class="form-control" asp-items="@(new SelectList(ViewBag.Departments, "DeptId", "Name", Model?.DeptId))">
                    <option selected disabled>Select Department</option>

                </select>
                <span asp-validation-for="DeptId" class="text-danger"></span>
            </div>
        </div>

        <hr class="mb-4">

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>