@model MVC01.ViewModels.StudentCourseEnrollmentVM

@{
    ViewData["Title"] = "Assign Courses";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-book me-2"></i> Assign Courses</h4>
        </div>
        <div class="card-body">
            <form asp-action="Assign" method="post">
                <input type="hidden" asp-for="Student_Id" />
                <input type="hidden" asp-for="Student_Name" />

                <h5 class="mb-4">Student: <span class="text-primary">@Model?.Student_Name</span></h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%" class="text-center">Select</th>
                                <th style="width: 60%">Course Name</th>
                                <th style="width: 30%">Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model?.Courses?.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="hidden" asp-for="Courses[i].courseId" />
                                        <input type="checkbox" asp-for="Courses[i].IsSelected" class="form-check-input border-primary" style="transform: scale(1.2);" />
                                    </td>
                                    <td class="fw-bold">
                                        <input type="hidden" asp-for="Courses[i].Name" />
                                        <input type="hidden" asp-for="Courses[i].TotalDegree" />
                                        @Model.Courses[i].Name <span class="text-muted">(Max: @Model.Courses[i].TotalDegree)</span>
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm w-50">
                                            <input type="number" asp-for="Courses[i].Degree" class="form-control" min="0" max="@Model.Courses[i].TotalDegree" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <span asp-validation-for="Courses[i].Degree" class="text-danger small"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>