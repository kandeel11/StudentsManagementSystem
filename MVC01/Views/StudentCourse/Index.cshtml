@using MVC01.ViewModels
@{
    ViewData["Title"] = "Course Assignment";
}
@model StudentCourseEnrollmentVM

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-book-reader me-2"></i> Student Enrollment Management</h5>
            <button id="btnAddNew" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#assignModal" disabled>
                <i class="fas fa-plus-circle"></i> Assign New Course
            </button>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Select Student</label>
                    <select id="studentSelect" class="form-select border-primary" asp-items=@(new SelectList(ViewBag.Students, "SSn", "Name", Model?.Student_Id))>
                        <option value="" disabled selected>-- Select a student --</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40%">Course Name</th>
                            <th style="width: 30%">Grade</th>
                            <th style="width: 30%">MinDegree</th>
                        </tr>
                    </thead>
                    <tbody id="enrolledCoursesBody">
                        @if (Model?.Courses == null || !Model.Courses.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No courses enrolled for this student.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model?.Courses)
                            {
                                <tr>
                                    <td>
                                        @item.Name
                                    </td>
                                    @if (item.Degree <= item.MinDegree)
                                    {
                                        <td class="text-danger fw-bold">@item.Degree</td>
                                        <td >@item.MinDegree</td>
                                    }else
                                    {
                                    <td>@item.Degree</td>
                                     <td>@item.MinDegree</td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Available Courses</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="availableCoursesList" class="list-group">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="saveAssignments()">Confirm Assignment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
           let ID = window.location.href.split("/")[5]
           if(ID){
                $('#studentSelect').val(ID);
           }
            $('#studentSelect').on('change', function () {
                const studentId = $(this).val();
                if (studentId) {
                   
                    window.location.href = `/StudentCourse/Index/${studentId}`;
                
                } else {
                    $('#enrolledCoursesBody').html('<tr><td colspan="3" class="text-center text-muted">Please select a student.</td></tr>');
                }
            });
        });

        
        

    </script>
}