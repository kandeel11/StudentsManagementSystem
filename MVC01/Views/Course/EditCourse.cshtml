@model MVC01.Models.Course

<div class="container mt-4">
    <h2 class="mb-4">Edit Course</h2>

    <form method="post" asp-action="EditCourse" asp-route-id="@Model.Crs_Id">
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Course Name</label>
                <input asp-for="Name" class="form-control" />
            </div>
            
            <div class="col-md-6 mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Total_Degree" class="form-label">Total Degree</label>
                <input asp-for="Total_Degree" type="number" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Min_Degree" class="form-label">Min Degree</label>
                <input asp-for="Min_Degree" type="number" class="form-control" />
            </div>
        </div>

        <hr class="mb-4">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
