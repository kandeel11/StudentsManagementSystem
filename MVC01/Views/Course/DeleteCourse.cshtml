@model MVC01.Models.Course

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Delete Course</h2>
    
    <h4>Are you sure you want to delete this course?</h4>
    <hr />
    <ul class="row">
        <li class="col-sm-2">Course ID</li>
        <span class="col-sm-10">@Model.Crs_Id</span>

        <li class="col-sm-2">Name</li>
        <span class="col-sm-10">@Model.Name</span>

        <li class="col-sm-2">Description</li>
        <span class="col-sm-10">@Model.Description</span>
        
        <li class="col-sm-2">Total Degree</li>
        <span class="col-sm-10">@Model.Total_Degree</span>

        <li class="col-sm-2">Min Degree</li >
        <span class="col-sm-10">@Model.Min_Degree</span>
    </ul>

    <form method="post" asp-action="ConfirmDeleteCourse" asp-route-id="@Model.Crs_Id">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
