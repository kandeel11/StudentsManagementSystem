@model ICollection<MVC01.Models.Course>
@section Nav {
    <a class="navbar-brand" asp-controller="Course" asp-action="Index">Course Management</a>
}
@section Header {
    <h1 class="text-center">Courses Management</h1>
}

<div class="container mt-4">
    <h2>Courses</h2>
    <a class="btn btn-info mb-3" asp-action="AddCourse">Add Course</a>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Course ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Total Degree</th>
                <th>Min Degree</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null)
            {
                foreach (var course in Model)
                {
                    <tr>
                        <td>@course.Crs_Id</td>
                        <td>@course.Name</td>
                        <td>@course.Description</td>
                        <td>@course.Total_Degree</td>
                        <td>@course.Min_Degree</td>
                        <td>
                            <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@course.Crs_Id">Details</a>
                            <a class="btn btn-warning btn-sm" asp-action="EditCourse" asp-route-id="@course.Crs_Id">Edit</a>
                            <a class="btn btn-danger btn-sm" asp-action="DeleteCourse" asp-route-id="@course.Crs_Id">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>