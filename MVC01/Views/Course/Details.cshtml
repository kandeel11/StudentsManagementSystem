@model MVC01.Models.Course

<div class="container mt-4">
    <h2>Course Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Course ID</dt>
        <dd class="col-sm-10">@Model.Crs_Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Total Degree</dt>
        <dd class="col-sm-10">@Model.Total_Degree</dd>

        <dt class="col-sm-2">Min Degree</dt>
        <dd class="col-sm-10">@Model.Min_Degree</dd>
    </dl>
    
    <h4 class="mt-4">Enrolled Students</h4>
    @if (Model.Student_Crs != null && Model.Student_Crs.Any())
    {
        <table class="table table-bordered mt-2">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sc in Model.Student_Crs)
                {
                    <tr>
                        <td>@sc.Student?.SSn</td>
                        <td>@sc.Student?.Name</td>
                        <td>@sc.Grade</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No students enrolled in this course.</p>
    }

    <div class="mt-4">
        <a asp-action="EditCourse" asp-route-id="@Model.Crs_Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
