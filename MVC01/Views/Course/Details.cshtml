@model MVC01.Models.Course

<div class="container mt-5 pb-5">
    @* Top Navigation & Actions *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">Course Insights</h2>
        </div>
        <div class="btn-group shadow-sm rounded-pill overflow-hidden">
            <a asp-action="EditCourse" asp-route-id="@Model.Crs_Id" class="btn btn-warning px-4">
                <i class="fas fa-edit me-2"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-light px-4 border-start">
                <i class="fas fa-list me-2"></i>Back
            </a>
        </div>
    </div>

    <div class="row g-4">
        @* Left Column: Course Overview *@
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-primary py-4 text-center">
                    <div class="icon-box bg-white text-primary rounded-circle shadow-sm mb-3 mx-auto">
                        <i class="fas fa-graduation-cap fa-2x"></i>
                    </div>
                    <h3 class="text-white fw-bold mb-0">@Model.Name</h3>
                    <small class="text-white-50 text-uppercase tracking-wider">Course ID: #@Model.Crs_Id</small>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="text-muted small text-uppercase fw-bold mb-2">About this Course</h6>
                        <p class="text-dark">@(Model.Description ?? "No description available for this module.")</p>
                    </div>

                    <hr class="my-4 opacity-5">

                    <div class="row text-center g-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-4">
                                <div class="text-muted small mb-1">Max Grade</div>
                                <div class="h4 fw-bold mb-0">@Model.Total_Degree</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-4 border border-success border-opacity-25">
                                <div class="text-muted small mb-1">Passing Mark</div>
                                <div class="h4 fw-bold text-success mb-0">@Model.Min_Degree</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Passing Threshold</span>
                            <span class="fw-bold">@((Model.Min_Degree * 100) / Model.Total_Degree)%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            <div class="progress-bar bg-success shadow-none" role="progressbar"
                                 style="width: @((Model.Min_Degree * 100) / Model.Total_Degree)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Right Column: Student Performance Table *@
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-users text-primary me-2"></i>Enrolled Students</h5>
                    <span class="badge bg-soft-primary text-primary px-3 rounded-pill">
                        @(Model.Student_Crs?.Count() ?? 0) Students
                    </span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 border-0 text-uppercase small text-muted">Student</th>
                                <th class="border-0 text-uppercase small text-muted">Grade</th>
                                <th class="border-0 text-uppercase small text-muted text-end pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Student_Crs != null && Model.Student_Crs.Any())
                            {
                                foreach (var sc in Model.Student_Crs)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-xs bg-light text-secondary rounded-circle me-2">
                                                    <i class="fas fa-user small"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@sc.Student?.Name</div>
                                                    <small class="text-muted">ID: @sc.Student?.SSn</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold @(sc.Grade >= Model.Min_Degree ? "text-success" : "text-danger")">
                                                @sc.Grade / @Model.Total_Degree
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (sc.Grade >= Model.Min_Degree)
                                            {
                                                <span class="badge bg-soft-success text-success px-3 rounded-pill">Passed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-soft-danger text-danger px-3 rounded-pill">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5 text-muted italic">
                                        <i class="fas fa-user-slash d-block mb-2 fa-2x opacity-25"></i>
                                        No students enrolled in this course yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>