@model MVC01.ViewModels.ProfileVM

@{
    ViewData["Title"] = "Admin Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4><i class="fas fa-user-shield me-2"></i> Admin Profile</h4>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="~/images/@Model.ImageUrl" alt="Profile Image" class="rounded-circle mb-3 shadow" style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #dee2e6;" />
                    }
                    else
                    {
                        <div class="rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center bg-secondary text-white shadow" style="width: 150px; height: 150px; font-size: 3rem;">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                    
                    <h5 class="card-title mt-3 fw-bold">@Model.UserName</h5>
                    <p class="card-text text-muted">
                        <i class="fas fa-map-marker-alt me-1"></i> @(string.IsNullOrEmpty(Model.Address) ? "No Address Provided" : Model.Address)
                    </p>

                    <hr class="mt-4 mb-4" />
                    
                    <div class="d-flex justify-content-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-1"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>