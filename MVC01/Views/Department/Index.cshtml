@model ICollection<MVC01.Models.Department>

<div class="container mt-5">
    @* Header Section *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="fw-bold text-dark mb-1"><i class="fas fa-building-columns text-primary me-2"></i>Departments</h1>
            <p class="text-muted mb-0">Overview of university departments and capacity</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary shadow-sm px-4 rounded-pill fw-bold" asp-action="AddDepartment">
                <i class="fas fa-plus me-2"></i> Create Department
            </a>
        }
    </div>

    @* Stats Summary (Optional but looks great) *@
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-primary text-white">
                <div class="small opacity-75 text-uppercase fw-bold">Total Departments</div>
                <div class="h3 mb-0 fw-bold">@Model?.Count()</div>
            </div>
        </div>
    </div>

    @* Main Table Card *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary small text-uppercase">ID</th>
                        <th class="py-3 text-secondary small text-uppercase">Department Info</th>
                        <th class="py-3 text-secondary small text-uppercase">Location</th>
                        <th class="py-3 text-secondary small text-uppercase text-center">Analytics</th>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <th class="py-3 text-secondary small text-uppercase text-center">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-light text-primary border fw-medium">#@dept?.DeptId</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark fs-5">@dept?.Name</div>
                                <div class="text-muted small"><i class="fas fa-phone-alt me-1"></i> @dept?.PhoneNumber</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="icon-shape bg-soft-info text-info me-2">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </div>
                                    <span class="text-dark">@dept?.Location</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <div class="px-3 py-1 bg-soft-success rounded-pill border border-success border-opacity-10" title="Students">
                                        <i class="fas fa-user-graduate text-success small me-1"></i>
                                        <span class="fw-bold text-success">@dept?.Students?.Count()</span>
                                    </div>
                                    <div class="px-3 py-1 bg-soft-purple rounded-pill border border-purple border-opacity-10" title="Instructors">
                                        <i class="fas fa-chalkboard-user text-purple small me-1"></i>
                                        <span class="fw-bold text-purple">@dept?.Instructors?.Count()</span>
                                    </div>
                                </div>
                            </td>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td class="text-center pe-3">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                        <a class="btn btn-white btn-sm px-3 border-end" asp-action="Details" asp-route-id="@dept?.DeptId" title="Details">
                                            <i class="fas fa-info-circle text-info"></i>
                                        </a>
                                        <a class="btn btn-white btn-sm px-3 border-end" asp-action="EditDepartment" asp-route-id="@dept?.DeptId" title="Edit">
                                            <i class="fas fa-pen text-warning"></i>
                                        </a>
                                        <a class="btn btn-white btn-sm px-3" asp-action="DeleteDepartment" asp-route-id="@dept?.DeptId" title="Delete">
                                            <i class="fas fa-trash-alt text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>