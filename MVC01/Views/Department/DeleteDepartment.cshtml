@model MVC01.Models.Department
@section Nav {
    <a class="navbar-brand" asp-controller="Department" asp-action="Index">Department Management</a>
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Delete Department</h2>
    
    <h4>Are you sure you want to delete this department?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Department ID</dt>
        <dd class="col-sm-10">@Model.DeptId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>
    </dl>

    <form method="post" asp-action="DeleteDepartment">
        <input type="hidden" asp-for="DeptId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
