@model MVC01.Models.Department
@section Nav {
    <a class="navbar-brand" asp-controller="Department" asp-action="Index">Department Management</a>
}

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Delete Department</h2>
    
    <h4>Are you sure you want to delete this department?</h4>
    <hr />
    <ul class="row">
        <li class="col-sm-2">Department ID</li>
        <span class="col-sm-10">@Model.DeptId</span>

        <li class="col-sm-2">Name</li>
        <span class="col-sm-10">@Model.Name</span>

        <li class="col-sm-2">Location</li>
        <span class="col-sm-10">@Model.Location</span>
        
        <li class="col-sm-2">Phone</li>
        <span class="col-sm-10">@Model.PhoneNumber</span>
    </ul>

    <form method="post" asp-action="ConfirmDeleteDepartment" asp-route-id="@Model.DeptId">
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
