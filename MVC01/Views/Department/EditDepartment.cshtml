@model MVC01.Models.Department
@section Nav {
    <a class="navbar-brand" asp-controller="Department" asp-action="Index">Department Management</a>
}
<div class="container mt-4">
    <h2 class="mb-4">Edit Department</h2>

    <form method="post" asp-action="EditDepartment" asp-route-id="@Model.DeptId">
        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label">Department Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter Department name" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control" placeholder="Enter address" />
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
            </div>

        </div>

        <hr class="mb-4">

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Update</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>
