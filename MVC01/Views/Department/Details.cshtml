@model MVC01.Models.Department

<div class="container mt-4">
    <h2>Department Details</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Department ID</dt>
        <dd class="col-sm-10">@Model.DeptId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Location</dt>
        <dd class="col-sm-10">@Model.Location</dd>
        
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>
    </dl>
    
    <h4 class="mt-4">Students</h4>
    @if (Model.Students != null && Model.Students.Any())
    {
        <ul>
            @foreach (var student in Model.Students)
            {
                <li>@student.Name (SSN: @student.SSn)</li>
            }
        </ul>
    }
    else
    {
        <p>No students in this department.</p>
    }

    <h4 class="mt-4">Instructors</h4>
    @if (Model.Instructors != null && Model.Instructors.Any())
    {
        <ul>
            @foreach (var instructor in Model.Instructors)
            {
                <li>@instructor.Name</li>
            }
        </ul>
    }
    else
    {
        <p>No instructors in this department.</p>
    }

    <div class="mt-4">
        <a asp-action="EditDepartment" asp-route-id="@Model.DeptId" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
