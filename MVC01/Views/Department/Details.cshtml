@model MVC01.Models.Department

<div class="container mt-5 pb-5">
    @* Page Header *@
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Departments</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0">@Model.Name Department</h2>
        </div>
    </div>

    <div class="row g-4">
        @* Left Column: Department Info *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center border-bottom bg-light rounded-top-4">
                    <div class="icon-lg bg-primary text-white rounded-circle shadow-sm mb-3 mx-auto">
                        <i class="fas fa-building-columns fa-2x"></i>
                    </div>
                    <h4 class="fw-bold">@Model.Name</h4>
                    <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill">ID: #@Model.DeptId</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold">Location</label>
                        <div class="d-flex align-items-center mt-1">
                            <i class="fas fa-map-marker-alt text-danger me-2"></i>
                            <span class="text-dark fw-medium">@Model.Location</span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold">Contact Phone</label>
                        <div class="d-flex align-items-center mt-1">
                            <i class="fas fa-phone-alt text-success me-2"></i>
                            <span class="text-dark fw-medium">@Model.PhoneNumber</span>
                        </div>
                    </div>
                    <div class="d-grid gap-2 pt-3">
                        <a asp-action="EditDepartment" asp-route-id="@Model.DeptId" class="btn btn-warning fw-bold rounded-pill shadow-sm">
                            <i class="fas fa-edit me-2"></i>Edit Department
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @* Right Column: Lists *@
        <div class="col-lg-8">
            @* Students List *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-graduate text-primary me-2"></i>Enrolled Students</h5>
                    <span class="badge bg-light text-dark border">@(Model.Students?.Count() ?? 0) Total</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush rounded-bottom-4">
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            @foreach (var student in Model.Students)
                            {
                                <div class="list-group-item list-group-item-action border-0 px-4 py-3 d-flex align-items-center">
                                    <div class="avatar-sm bg-light text-secondary rounded-circle me-3">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">@student.Name</div>
                                        <small class="text-muted">SSN: @student.SSn</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <p class="mb-0">No students found in this department.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Instructors List *@
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chalkboard-user text-success me-2"></i>Department Instructors</h5>
                    <span class="badge bg-light text-dark border">@(Model.Instructors?.Count() ?? 0) Total</span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush rounded-bottom-4">
                        @if (Model.Instructors != null && Model.Instructors.Any())
                        {
                            @foreach (var instructor in Model.Instructors)
                            {
                                <div class="list-group-item list-group-item-action border-0 px-4 py-3 d-flex align-items-center">
                                    <div class="avatar-sm bg-light text-success rounded-circle me-3">
                                        <i class="fas fa-user-tie"></i>
                                    </div>
                                    <div class="fw-bold text-dark">@instructor.Name</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <p class="mb-0">No instructors assigned yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>