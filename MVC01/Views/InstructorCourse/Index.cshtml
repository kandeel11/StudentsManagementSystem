@using MVC01.ViewModels
@{
    ViewData["Title"] = "Instructor Assignment";
}
@model InstructorCourseEnrollmentVM

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chalkboard-teacher me-2"></i> Instructor Enrollment Management</h5>
            @if (Model != null && Model.Instructor_Id > 0)
            {
                <a id="btnAddNew" class="btn btn-success btn-sm" asp-controller="InstructorCourse" asp-action="Assign" asp-route-id="@Model.Instructor_Id">
                    <i class="fas fa-plus-circle"></i> Assign New Course
                </a>
            }
            else
            {
                <button id="btnAddNew" class="btn btn-success btn-sm" disabled>
                    <i class="fas fa-plus-circle"></i> Assign New Course
                </button>
            }
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Select Instructor</label>
                    <select id="instructorSelect" class="form-select border-primary" asp-items=@(new SelectList(ViewBag.Instructors, "Ins_Id", "Name", Model?.Instructor_Id))>
                        <option value="" disabled selected>-- Select an instructor --</option>
                    </select>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 100%">Course Name</th>
                        </tr>
                    </thead>
                    <tbody id="enrolledCoursesBody">
                        @if (Model?.Courses == null || !Model.Courses.Any())
                        {
                            <tr>
                                <td colspan="1" class="text-center text-muted">No courses enrolled for this instructor.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model?.Courses)
                            {
                                <tr>
                                    <td>
                                        @item.Name
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
           let ID = window.location.href.split("/")[5];
           if(ID){
                $('#instructorSelect').val(ID);
           }
            $('#instructorSelect').on('change', function () {
                const instructorId = $(this).val();
                if (instructorId) {
                    window.location.href = `/InstructorCourse/Index/${instructorId}`;
                } else {
                    $('#enrolledCoursesBody').html('<tr><td colspan="1" class="text-center text-muted">Please select an instructor.</td></tr>');
                }
            });
        });
    </script>
}