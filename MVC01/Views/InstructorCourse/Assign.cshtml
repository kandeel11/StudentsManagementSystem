@model MVC01.ViewModels.InstructorCourseEnrollmentVM

@{
    ViewData["Title"] = "Assign Courses to Instructor";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-book me-2"></i> Assign Courses</h4>
        </div>
        <div class="card-body">
            <form asp-action="Assign" method="post">
                <input type="hidden" asp-for="Instructor_Id" />
                <input type="hidden" asp-for="Instructor_Name" />
                
                <h5 class="mb-4">Instructor: <span class="text-primary">@Model?.Instructor_Name</span></h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%" class="text-center">Select</th>
                                <th style="width: 90%">Course Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model?.Courses?.Count; i++)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="hidden" asp-for="Courses[i].CourseId" />
                                        <input type="checkbox" asp-for="Courses[i].IsSelected" class="form-check-input border-primary" style="transform: scale(1.2);" />
                                    </td>
                                    <td class="fw-bold">
                                        <input type="hidden" asp-for="Courses[i].Name" />
                                        @Model.Courses[i].Name
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 text-end">
                    <a asp-controller="Instructor" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>