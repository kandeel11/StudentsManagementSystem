<div class="container ">
<a class="btn btn-info " asp-action="AddStudent">Add Student</a>
@section Header{
    <h1>Students Management</h1>
    }

   
<table class="table table-striped">
    <tr>
        <th>SSn</th>
        <th>Name</th>
        <th>Address</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Image</th>
        <th>Actions</th>
    </tr>
    @foreach (var student in Model)
    {
        <tr>
            <td>@student.SSn</td>
            <td>@student.Name</td>
            <td>@student.Address</td>
            <td>@student.Email</td>
            <td>@student.Phone</td>
            <td><img src="/Images/@student.Image" alt="Student Image" width="100" /></td>
            <td>
                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@student.SSn">Details</a>
                <a class="btn btn-warning btn-sm" asp-action="EditStudent" asp-route-id="@student.SSn">Edit</a>
                <a class="btn btn-danger btn-sm" asp-action="DeleteStudent" asp-route-id="@student.SSn">Delete</a>
            </td>
        </tr>
    }
</table>
</div>
