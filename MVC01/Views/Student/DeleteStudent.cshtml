@model MVC01.Models.Student

<div class="container mt-4">
    <h2 class="mb-4 text-danger">Delete Student</h2>
    
    <h4>Are you sure you want to delete this student?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">SSn</dt>
        <dd class="col-sm-10">@Model.SSn</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        
        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
    </dl>

    <form method="post" asp-action="DeleteStudent">
        <input type="hidden" asp-for="SSn" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
