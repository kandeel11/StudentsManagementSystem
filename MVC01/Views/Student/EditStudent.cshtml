@model MVC01.Models.Student
@section Header {
    <h1> EDIT Students </h1>
}



<div class="container mt-4">
    <h2 class="mb-4">Edit Student</h2>

    <form method="post" asp-action="EditStudent" enctype="multipart/form-data" asp-route-id="@Model.SSn">
