@model Student
<div class="row">
           

    <div class="col-md-6 mb-3">
        <label asp-for="Name" class="form-label">Student Name</label>
        <input asp-for="Name" class="form-control" placeholder="Enter student name" value="@Model?.Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Address" class="form-label">Address</label>
        <input asp-for="Address" class="form-control" placeholder="Enter address" value="@Model?.Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Phone" class="form-label">Phone Number</label>
        <input asp-for="Phone" class="form-control" placeholder="Enter phone number" value="@Model?.Phone" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Email" class="form-label">Email Address</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" value="@Model?.Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Age" class="form-label">Age</label>
        <input asp-for="Age" type="number" class="form-control" placeholder="Enter age" value="@Model?.Age" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="DeptId" class="form-label">Department</label>
        <select asp-for="DeptId" class="form-select">

            <option value="" disabled selected>-- Select Department --</option>
            @foreach (var dept in ViewBag.Departments)
            {
                <option value="@dept.DeptId">@dept.Name</option>
            }
        </select>
    </div>

    <div class="col-md-12 mb-4">
        <label asp-for="Image" class="form-label">Student Image</label>
        <input asp-for="Image" type="file" class="form-control" accept="image/*" />
        <input type="hidden" name="ExistingImage" value="@Model?.Image" />
        <span asp-validation-for="Image" class="text-danger"></span>
        @if (!string.IsNullOrEmpty(Model?.Image))
        {
            <p class="mt-2">Current image: <img src="~/Images/@Model.Image" height="50" /></p>
        }
    </div>
</div>

<hr class="mb-4">

<div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary px-4">Save</button>
    <a class="btn btn-secondary px-4" asp-action="Index">Return</a>
</div>